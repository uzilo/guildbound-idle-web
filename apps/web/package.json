{
  "name": "@guildbound/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first React web client for Guildbound. UI only — domain logic lives in workspace packages.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@guildbound/game-core": "workspace:*",
    "@guildbound/game-data": "workspace:*",
    "@guildbound/game-simulation": "workspace:*",
    "@guildbound/shared": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.2"
  }
}
