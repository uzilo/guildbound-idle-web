{
  "name": "guildbound-idle-web",
  "version": "0.1.0",
  "private": true,
  "description": "Guildbound — a mobile-first idle guild management RPG for the web.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "dev": "pnpm --filter @guildbound/web dev",
    "verify": "pnpm build && pnpm typecheck && pnpm check:boundaries && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
